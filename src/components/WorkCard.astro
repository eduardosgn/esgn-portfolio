---
import { Picture } from 'astro:assets';
import type { Work } from '../data/content';
import Icon from './Icon.astro';

interface Props extends Work {
  featured?: boolean;
  cta: string;
}

const { title, description, href, image, alt, featured = false, cta } = Astro.props;

const sizes = featured
  ? '(max-width: 1080px) calc(100vw - 32px), (max-width: 1440px) 48vw, 680px'
  : '(max-width: 640px) calc(100vw - 32px), (max-width: 960px) 50vw, (max-width: 1440px) 33vw, 460px';
---

<a class="card rv" href={href} target="_blank" rel="noopener">
  <div class="card-media tilt">
    <Picture
      class="card-img"
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[...[400, 600, 808, 1080].filter((w) => w < image.width), image.width]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
    />
    <span class="card-cta">{cta}</span>
  </div>
  <div class="card-info">
    <div>
      <h3 class="title card-title">{title}</h3>
      <p class="card-desc">{description}</p>
    </div>
    <span class="card-arrow" aria-hidden="true"><Icon name="arrow-ne" /></span>
  </div>
</a>
