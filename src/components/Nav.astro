---
import Icon from './Icon.astro';
import Clock from './Clock.astro';
import LangSwitch from './LangSwitch.astro';
import { contact, getContent } from '../data/content';

const t = getContent(Astro.currentLocale);
---

<header class="nav">
  <div class="wrap nav-in">
    <a class="logo" href="#topo" aria-label={t.a11y.logo} data-logo>esgn<span class="caret-l" aria-hidden="true">_</span></a>
    <nav aria-label={t.a11y.mainNav}>
      <ul class="nav-links">
        {
          t.nav.links.map((l) => (
            <li>
              <a class="nav-link" href={l.href}>
                <span class="roll">
                  <span>{l.label}</span>
                  <span aria-hidden="true">{l.label}</span>
                </span>
                <sup>{l.n}</sup>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="nav-right">
      <LangSwitch />
      <button
        class="icon-btn theme-btn js-only"
        type="button"
        aria-label={t.a11y.themeToLight}
        title={t.a11y.themeToLight}
        data-theme-toggle
        data-label-light={t.a11y.themeToLight}
        data-label-dark={t.a11y.themeToDark}
      >
        <Icon name="sun" size={18} class="i-sun" />
        <Icon name="moon" size={18} class="i-moon" />
      </button>
      <a class="btn btn-sm btn-solid nav-cta" href="#contato">
        <span class="roll"><span>{t.nav.cta}</span><span aria-hidden="true">{t.nav.cta}</span></span>
      </a>
      <button
        class="icon-btn menu-btn"
        type="button"
        aria-label={t.a11y.menuOpen}
        aria-expanded="false"
        aria-controls="menu-mobile"
        popovertarget="menu-mobile"
        data-menu-btn
        data-label-open={t.a11y.menuOpen}
        data-label-close={t.a11y.menuClose}
      >
        <Icon name="menu" size={18} class="i-menu" />
        <Icon name="close" size={18} class="i-close" />
      </button>
    </div>
  </div>
  <div class="mmenu" id="menu-mobile" popover>
    <nav class="mm-links" aria-label={t.a11y.menuNav}>
      {
        t.nav.links.map((l) => (
          <a class="mm-link" href={l.href}>
            {l.menuLabel}
            <sup>{l.n}</sup>
          </a>
        ))
      }
    </nav>
    <div class="mm-foot">
      <span class="status"><span class="pulse"></span>{t.status}</span>
      <a class="u" href={`mailto:${contact.email}`}>{contact.email}</a>
      <span>{contact.location}<Clock /></span>
    </div>
  </div>
</header>

<script>
  // Relógio de Barra Velha (America/Sao_Paulo), atualizado a cada 15s
  const fmt = new Intl.DateTimeFormat('pt-BR', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone: 'America/Sao_Paulo',
  });
  const tick = () => {
    const parts = fmt.formatToParts(new Date());
    const hh = parts.find((p) => p.type === 'hour')?.value ?? '--';
    const mm = parts.find((p) => p.type === 'minute')?.value ?? '--';
    document.querySelectorAll('[data-hh]').forEach((el) => (el.textContent = hh));
    document.querySelectorAll('[data-mm]').forEach((el) => (el.textContent = mm));
  };
  tick();
  setInterval(tick, 15000);

  // Tema (dark/light) com transição circular via View Transitions
  const root = document.documentElement;
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeMeta = document.querySelector('meta[name="theme-color"]');
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  const syncThemeUi = () => {
    const dark = root.dataset.theme !== 'light';
    const label = (dark ? themeBtn?.dataset.labelLight : themeBtn?.dataset.labelDark) ?? '';
    themeBtn?.setAttribute('aria-label', label);
    themeBtn?.setAttribute('title', label);
    themeMeta?.setAttribute('content', dark ? '#0A0A0B' : '#F4F4F2');
  };

  const applyTheme = (next: 'dark' | 'light') => {
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncThemeUi();
  };

  syncThemeUi();

  themeBtn?.addEventListener('click', (e) => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    if (!document.startViewTransition || reduce()) {
      applyTheme(next);
      return;
    }
    const x = e.clientX || innerWidth - 80;
    const y = e.clientY || 36;
    const vt = document.startViewTransition(() => applyTheme(next));
    vt.ready
      .then(() => {
        const r = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
        root.animate(
          { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${r}px at ${x}px ${y}px)`] },
          { duration: 700, easing: 'cubic-bezier(.16,1,.3,1)', pseudoElement: '::view-transition-new(root)' },
        );
      })
      .catch(() => {});
  });

  // Menu mobile: popover nativo; aqui só sincroniza rótulos e fecha ao navegar
  const menu = document.getElementById('menu-mobile');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  if (menu && menuBtn) {
    menu.addEventListener('toggle', (e) => {
      const open = (e as ToggleEvent).newState === 'open';
      menuBtn.setAttribute('aria-expanded', String(open));
      menuBtn.setAttribute('aria-label', (open ? menuBtn.dataset.labelClose : menuBtn.dataset.labelOpen) ?? '');
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.hidePopover()));
    matchMedia('(min-width: 1021px)').addEventListener('change', (e) => {
      if (e.matches && menu.matches(':popover-open')) menu.hidePopover();
    });
  }
</script>
