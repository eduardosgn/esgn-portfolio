---
import { Image } from 'astro:assets';
import photo from '../assets/images/eduardo.jpg';
import { getContent } from '../data/content';

const t = getContent(Astro.currentLocale);
const a = t.about;
---

<section class="sec sec-line" id="sobre" aria-labelledby="t-sobre">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="sec-idx">(02)</span>
      <h2 class="title sec-title" id="t-sobre">{a.title}</h2>
      <p class="sec-aside">{a.aside}</p>
    </div>
    <div class="about-grid">
      <div class="about-left rv">
        <figure class="photo">
          <Image src={photo} alt={a.photoAlt} width={400} height={400} densities={[1]} formats={['avif', 'webp']} loading="lazy" decoding="async" />
        </figure>
        <p class="statement">{a.statement}<br /><em>{a.statementEm}</em></p>
      </div>
      <div class="rv">
        <div class="about-text">
          {a.paragraphs.map((p) => <p set:html={p} />)}
        </div>
        <dl class="facts">
          {
            a.facts.map((f) => (
              <div class="fact">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
    <div class="services">
      {
        a.services.map((s, i) => (
          <article class="svc rv">
            <span class="svc-n">{String(i + 1).padStart(2, '0')} /</span>
            <h3 class="title svc-t">{s.title}</h3>
            <p>{s.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
