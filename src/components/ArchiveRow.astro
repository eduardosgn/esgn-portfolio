---
import Icon from './Icon.astro';

interface Props {
  title: string;
  type: string;
  href: string;
}

const { title, type, href } = Astro.props;
---

<a class="row rv" href={href} target="_blank" rel="noopener">
  <span class="row-main"><span class="title row-title">{title}</span><span class="row-type">{type}</span></span>
  <span class="row-arrow" aria-hidden="true"><Icon name="arrow-ne" size={20} /></span>
</a>
