---
import StackRow from './StackRow.astro';
import { getContent } from '../data/content';

const t = getContent(Astro.currentLocale);
---

<section class="sec sec-line" id="stack" aria-labelledby="t-stack">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="sec-idx">(03)</span>
      <h2 class="title sec-title" id="t-stack">{t.stack.title}</h2>
      <p class="sec-aside">{t.stack.aside}</p>
    </div>
    <div class="stack">
      {t.stack.groups.map((g) => <StackRow {...g} />)}
    </div>
  </div>
</section>
