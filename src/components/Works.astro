---
import LiveSiteCard from './LiveSiteCard.astro';
import WorkCard from './WorkCard.astro';
import ArchiveRow from './ArchiveRow.astro';
import Icon from './Icon.astro';
import { liveSites, featuredWorks, works, archive, contact } from '../data/content';
---

<section class="sec wrap" id="trabalhos" aria-labelledby="t-trabalhos" data-tilt-zone>
  <div class="sec-head rv">
    <span class="sec-idx">(01)</span>
    <h2 class="title sec-title" id="t-trabalhos">Trabalhos<br />selecionados</h2>
    <p class="sec-aside">
      Webapps, dashboards e redesigns de sites, do wireframe ao protótipo de alta fidelidade. Cada projeto abre no Behance ou no site no ar.
    </p>
  </div>

  <div class="live-head rv"><span class="live-label"><span class="pulse"></span>No ar agora</span><span>Front-end em produção</span></div>
  <div class="live-grid">
    {liveSites.map((s) => <LiveSiteCard {...s} />)}
  </div>

  <div class="live-head rv"><span class="live-label">Behance</span><span>Estudos de caso de UX/UI</span></div>
  <div class="works-feat">
    {featuredWorks.map((w) => <WorkCard {...w} featured />)}
  </div>
  <div class="works-grid">
    {works.map((w) => <WorkCard {...w} />)}
  </div>

  <div class="archive">
    <div class="archive-head"><span>Arquivo</span><span>Landing pages, motion e social media</span></div>
    {archive.map((a) => <ArchiveRow {...a} />)}
  </div>

  <div class="works-more">
    <a class="btn" href={contact.behance} target="_blank" rel="noopener">
      <span class="roll"><span>Ver tudo no Behance</span><span aria-hidden="true">Ver tudo no Behance</span></span>
      <Icon name="arrow-ne" class="i-ne" />
    </a>
  </div>
</section>

<script>
  // Tilt 3D dos cards (delegação de eventos na seção)
  const zone = document.querySelector<HTMLElement>('[data-tilt-zone]');
  const ok =
    matchMedia('(hover: hover) and (pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (zone && ok) {
    const props = ['--rx', '--ry', '--mx', '--my', '--gx', '--gy'];
    let current: HTMLElement | null = null;

    const reset = (el: HTMLElement | null) => {
      if (!el) return;
      el.classList.remove('is-tilt');
      props.forEach((p) => el.style.removeProperty(p));
    };

    zone.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      const el = (e.target as Element).closest<HTMLElement>('.tilt');
      if (current && current !== el) reset(current);
      current = el;
      if (!el) return;
      const r = el.getBoundingClientRect();
      if (!r.width || !r.height) return;
      const px = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      const py = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
      const mx = px * 2 - 1;
      const my = py * 2 - 1;
      const max = el.classList.contains('live-card') ? 5 : 7;
      el.classList.add('is-tilt');
      el.style.setProperty('--rx', (-my * max).toFixed(2) + 'deg');
      el.style.setProperty('--ry', (mx * max).toFixed(2) + 'deg');
      el.style.setProperty('--mx', mx.toFixed(3));
      el.style.setProperty('--my', my.toFixed(3));
      el.style.setProperty('--gx', (px * 100).toFixed(1) + '%');
      el.style.setProperty('--gy', (py * 100).toFixed(1) + '%');
    });

    zone.addEventListener('pointerleave', () => {
      reset(current);
      current = null;
    });
  }
</script>
