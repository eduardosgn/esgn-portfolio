---
import Icon from './Icon.astro';
import { getContent } from '../data/content';

const t = getContent(Astro.currentLocale);
// Ano do build como fallback sem JS; o script troca pelo ano atual do visitante
const buildYear = new Date().getFullYear();
---

<footer class="foot" data-foot>
  <div class="wrap foot-in">
    <span><span data-year>{buildYear}</span> Eduardo Nascimento</span>
    <a class="top-link" href="#topo">{t.footer.toTop} <Icon name="arrow-up" size={14} /></a>
  </div>
</footer>

<script>
  const year = document.querySelector('[data-year]');
  if (year) year.textContent = String(new Date().getFullYear());
</script>
