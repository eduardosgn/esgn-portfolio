---
import Icon from './Icon.astro';
import { contact, getContent } from '../data/content';

const t = getContent(Astro.currentLocale);
const c = t.contact;
---

<section class="contact" id="contato" aria-labelledby="t-contato">
  <div class="wrap">
    <span class="sec-idx">{c.idx}</span>
    <h2 class="title contact-title rv" id="t-contato">{c.title}<br />{c.titleEmPrefix}<em>{c.titleEm}</em></h2>
    <div class="contact-grid">
      <div class="mail-col rv">
        <p>{c.text}</p>
        <a class="mail u" href={`mailto:${contact.email}`}>{contact.email}</a>
        <button class="btn btn-sm copy-btn js-only" type="button" data-copy={contact.email} data-label-done={c.copied}>
          <Icon name="check" class="i-check" />
          <Icon name="copy" class="i-copy" />
          <span aria-live="polite" data-copy-label>{c.copy}</span>
        </button>
      </div>
      <div class="links rv">
        <a class="lnk" href={contact.linkedin} target="_blank" rel="noopener">
          <span>LinkedIn</span>
          <span class="lnk-meta"><span class="lnk-url">{contact.linkedinLabel}</span><Icon name="arrow-ne" size={18} /></span>
        </a>
        <a class="lnk" href={contact.behance} target="_blank" rel="noopener">
          <span>Behance</span>
          <span class="lnk-meta"><span class="lnk-url">{contact.behanceLabel}</span><Icon name="arrow-ne" size={18} /></span>
        </a>
        <a class="lnk" href={contact.cv} target="_blank" rel="noopener">
          <span>{c.cv}</span>
          <span class="lnk-meta"><span class="lnk-url">PDF</span><Icon name="download" size={18} class="i-dl" /></span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = btn?.querySelector('[data-copy-label]');
  const idle = label?.textContent ?? '';
  let timer = 0;

  btn?.addEventListener('click', async () => {
    const email = btn.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(email);
      btn.classList.add('is-copied');
      if (label) label.textContent = btn.dataset.labelDone ?? '';
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.classList.remove('is-copied');
        if (label) label.textContent = idle;
      }, 2200);
    } catch {
      window.location.href = `mailto:${email}`;
    }
  });
</script>
