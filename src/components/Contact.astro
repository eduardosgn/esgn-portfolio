---
import Icon from './Icon.astro';
import { contact } from '../data/content';
---

<section class="contact" id="contato" aria-labelledby="t-contato">
  <div class="wrap">
    <span class="sec-idx">(05) Contato</span>
    <h2 class="title contact-title rv" id="t-contato">Tem um projeto<br />em <em>mente?</em></h2>
    <div class="contact-grid">
      <div class="mail-col rv">
        <p>Aberto a vagas remotas e projetos freelance de produto, UX/UI e front-end. Me manda um e-mail:</p>
        <a class="mail u" href={`mailto:${contact.email}`}>{contact.email}</a>
        <button class="btn btn-sm copy-btn js-only" type="button" data-copy={contact.email}>
          <Icon name="check" class="i-check" />
          <Icon name="copy" class="i-copy" />
          <span aria-live="polite" data-copy-label>Copiar e-mail</span>
        </button>
      </div>
      <div class="links rv">
        <a class="lnk" href={contact.linkedin} target="_blank" rel="noopener">
          <span>LinkedIn</span>
          <span class="lnk-meta"><span class="lnk-url">{contact.linkedinLabel}</span><Icon name="arrow-ne" size={18} /></span>
        </a>
        <a class="lnk" href={contact.behance} target="_blank" rel="noopener">
          <span>Behance</span>
          <span class="lnk-meta"><span class="lnk-url">{contact.behanceLabel}</span><Icon name="arrow-ne" size={18} /></span>
        </a>
        <a class="lnk" href={contact.cv} target="_blank" rel="noopener">
          <span>Currículo</span>
          <span class="lnk-meta"><span class="lnk-url">PDF</span><Icon name="download" size={18} class="i-dl" /></span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const label = btn?.querySelector('[data-copy-label]');
  let timer = 0;

  btn?.addEventListener('click', async () => {
    const email = btn.dataset.copy ?? '';
    try {
      await navigator.clipboard.writeText(email);
      btn.classList.add('is-copied');
      if (label) label.textContent = 'E-mail copiado!';
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.classList.remove('is-copied');
        if (label) label.textContent = 'Copiar e-mail';
      }, 2200);
    } catch {
      window.location.href = `mailto:${email}`;
    }
  });
</script>
