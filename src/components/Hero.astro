---
import GooSlash from './GooSlash.astro';
import CodeCard from './CodeCard.astro';
import Icon from './Icon.astro';
import { contact, getContent } from '../data/content';

const t = getContent(Astro.currentLocale);
// A seção ocupa a largura toda (o goo segue o mouse até as bordas); o conteúdo fica no .wrap
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <GooSlash />
  <div class="wrap">
    <div class="hero-meta">
      <ul class="hero-tags" aria-label={t.a11y.areas}>
        {t.hero.tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
    </div>
    <h1 class="title hero-name" id="hero-title" data-hero-name>
      <span class="line"><span>Eduardo</span></span>
      <span class="line line-2"><span>Nascime<span class="slash-anchor"></span>nto<span class="acc">.</span></span></span>
    </h1>
    <div class="hero-bottom">
      <div>
        <p class="lead">{t.hero.lead} <em>{t.hero.leadEm}</em></p>
        <div class="btn-row">
          <a class="btn btn-solid" href="#trabalhos">
            <span class="roll"><span>{t.hero.ctaWorks}</span><span aria-hidden="true">{t.hero.ctaWorks}</span></span>
            <Icon name="arrow-down" class="i-dn" />
          </a>
          <a class="btn" href={contact.cv} target="_blank" rel="noopener">
            <span class="roll"><span>{t.hero.ctaCv}</span><span aria-hidden="true">{t.hero.ctaCv}</span></span>
            <Icon name="download" class="i-dn" />
          </a>
        </div>
      </div>
      <CodeCard />
    </div>
  </div>
</section>
