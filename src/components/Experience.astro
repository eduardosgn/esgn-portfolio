---
import ExperienceItem from './ExperienceItem.astro';
import { getContent } from '../data/content';

const t = getContent(Astro.currentLocale);
---

<section class="sec sec-line" id="experiencia" aria-labelledby="t-xp">
  <div class="wrap">
    <div class="sec-head rv">
      <span class="sec-idx">(04)</span>
      <h2 class="title sec-title" id="t-xp">{t.experience.title}</h2>
      <p class="sec-aside">{t.experience.aside}</p>
    </div>
    <div class="xp">
      {t.experience.items.map((x, i) => <ExperienceItem {...x} open={i === 0} />)}
    </div>

    <div class="edu">
      <h3 class="edu-h">{t.experience.eduTitle}</h3>
      <ul class="edu-grid rv">
        {
          t.experience.education.map((e) => (
            <li class="edu-card">
              <span class="edu-years">{e.years}</span>
              <span class="title edu-course">{e.course}</span>
              <span class="edu-school">{e.school}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
