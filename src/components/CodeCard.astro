---
import { getContent } from '../data/content';

const t = getContent(Astro.currentLocale);
---

<figure class="code-card" aria-label={t.a11y.codeCard}>
  <div class="code-head">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span>edu.config.js</span>
    <span>JS</span>
  </div>
  <code class="code">
    <span class="cl"><span class="k">const</span> edu <span class="p">=</span> <span class="p">{"{"}</span></span>
    <span class="cl"><i class="in"></i>role<span class="p">:</span> <span class="s">"Product Designer"</span><span class="p">,</span></span>
    <span class="cl"><i class="in"></i>xp<span class="p">:</span> <span class="s">"{t.hero.codeXp}"</span><span class="p">,</span></span>
    <span class="cl"><i class="in"></i>design<span class="p">:</span> <span class="p">[</span><span class="s">"Figma"</span><span class="p">,</span> <span class="s">"FigJam"</span><span class="p">],</span></span>
    <span class="cl"><i class="in"></i>process<span class="p">:</span> <span class="p">[</span><span class="s">"Scrum"</span><span class="p">,</span> <span class="s">"Kanban"</span><span class="p">],</span></span>
    <span class="cl"><i class="in"></i>front<span class="p">:</span> <span class="p">[</span><span class="s">"HTML"</span><span class="p">,</span> <span class="s">"CSS"</span><span class="p">,</span> <span class="s">"JS"</span><span class="p">],</span></span>
    <span class="cl"><i class="in"></i>frameworks<span class="p">:</span> <span class="p">[</span><span class="s">"Vue"</span><span class="p">,</span> <span class="s">"React"</span><span class="p">],</span></span>
    <span class="cl"><i class="in"></i>ai<span class="p">:</span> <span class="p">[</span></span>
    <span class="cl"><i class="in"></i><i class="in"></i><span class="s">"Claude Code"</span><span class="p">,</span></span>
    <span class="cl"><i class="in"></i><i class="in"></i><span class="s">"Claude Design"</span><span class="p">,</span></span>
    <span class="cl"><i class="in"></i><i class="in"></i><span class="s">"MCPs"</span><span class="p">,</span></span>
    <span class="cl"><i class="in"></i><span class="p">],</span></span>
    <span class="cl"><i class="in"></i>based<span class="p">:</span> <span class="s">"Barra Velha, SC"</span><span class="p">,</span></span>
    <span class="cl"><i class="in"></i>remote<span class="p">:</span> <span class="k">true</span><span class="p">,</span></span>
    <span class="cl"><span class="p">{"};"}</span><span class="caret" aria-hidden="true"></span></span>
  </code>
</figure>
